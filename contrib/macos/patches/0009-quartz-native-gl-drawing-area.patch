+  g_signal_connect (widget, "configure-event", G_CALLBACK (ghid_quartz_gl_configure), NULL);
+  g_signal_connect (widget, "size-allocate", G_CALLBACK (ghid_quartz_gl_allocate), NULL);
+#endif
