+/* gdkquartz.h includes Objective-C AppKit headers, so declare its C ABI here. */
+extern id gdk_quartz_window_get_nsview (GdkWindow *window);
+#endif
 
 #ifdef HAVE_LIBDMALLOC
 #include <dmalloc.h>
@@ -830,11 +838,75 @@
   port->render_priv = NULL;
