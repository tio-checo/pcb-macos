+#ifdef GDK_WINDOWING_QUARTZ
+static void
+ghid_quartz_gl_sync_view (GtkWidget *widget)
+{
+  GtkWidget *top;
+  GdkWindow *window = gtk_widget_get_window (widget);
+  id view, root, parent;
+  gint x = 0, y = 0;
+  CGRect frame;
+
+  if (window == NULL)
+    return;
+  if (!gdk_window_ensure_native (window))
+    g_error ("Cannot create a native Quartz OpenGL drawing area");
+  top = gtk_widget_get_toplevel (widget);
+  view = (id) gdk_quartz_window_get_nsview (window);
+  root = (id) gdk_quartz_window_get_nsview (gtk_widget_get_window (top));
+  gtk_widget_translate_coordinates (widget, top, 0, 0, &x, &y);
+  frame = CGRectMake (x, y, widget->allocation.width, widget->allocation.height);
+  parent = ((id (*)(id, SEL)) objc_msgSend) (view, sel_registerName ("superview"));
+  if (parent != root)
+    {
+#ifdef __aarch64__
+      frame = ((CGRect (*)(id, SEL, CGRect, id)) objc_msgSend)
+        (root, sel_registerName ("convertRect:toView:"), frame, parent);
+#else
+      ((void (*)(CGRect *, id, SEL, CGRect, id)) objc_msgSend_stret)
+        (&frame, root, sel_registerName ("convertRect:toView:"), frame, parent);
+#endif
+    }
+  /* Quartz's legacy native child windows can retain their initial 1x1
+   * NSView frame after GTK allocation. Keep the OpenGL drawable aligned
+   * with its widget; never attach it to the top-level view. */
+  ((void (*)(id, SEL, CGRect)) objc_msgSend)
+    (view, sel_registerName ("setFrame:"), frame);
+}
+
+static gboolean
+ghid_quartz_gl_configure (GtkWidget *widget, GdkEventConfigure *event,
+                          gpointer unused)
+{
+  (void) event;
+  (void) unused;
+  ghid_quartz_gl_sync_view (widget);
+  return FALSE;
+}
+
+static void
+ghid_quartz_gl_allocate (GtkWidget *widget, GtkAllocation *allocation,
+                         gpointer unused)
+{
+  (void) allocation;
+  (void) unused;
+  ghid_quartz_gl_sync_view (widget);
+}
+#endif
+
 void
