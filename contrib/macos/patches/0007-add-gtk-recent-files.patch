 /* SIGNAL HANDLERS */
+
+/* Match Lepton's GTK recent-file menu, while keeping PCB's profile separate.
+ * An explicit filename also avoids GTK2's migration of ~/.recently-used.xbel. */
+static GtkRecentManager *recent_manager;
+
+static GtkRecentManager *
+ghid_recent_manager (void)
+{
+  if (recent_manager == NULL)
+    {
+      gchar *filename;
+      g_mkdir_with_parents (g_get_user_data_dir (), 0700);
+      filename = g_build_filename (g_get_user_data_dir (), "recently-used.xbel", NULL);
+      recent_manager = g_object_new (GTK_TYPE_RECENT_MANAGER,
+                                    "filename", filename, NULL);
+      g_free (filename);
+    }
+  return recent_manager;
+}
+
+void
+ghid_recent_add_file (const char *filename)
+{
+  gchar *absolute, *uri, *launcher, *quoted, *command;
+  const gchar *resources = g_getenv ("PCB_BUNDLE_RESOURCES");
+  GtkRecentData data = { 0 };
+
+  if (filename == NULL || !g_file_test (filename, G_FILE_TEST_IS_REGULAR))
+    return;
+
+  absolute = g_canonicalize_filename (filename, NULL);
+  uri = g_filename_to_uri (absolute, NULL, NULL);
+  g_free (absolute);
+  if (uri == NULL)
+    return;
+
+  launcher = resources ? g_build_filename (resources, "..", "MacOS", "PCB", NULL)
+                       : g_strdup ("pcb");
+  quoted = g_shell_quote (launcher);
+  command = g_strconcat (quoted, " %f", NULL);
+  data.mime_type = "application/x-pcb-layout";
+  data.app_name = "PCB";
+  data.app_exec = command;
+  gtk_recent_manager_add_full (ghid_recent_manager (), uri, &data);
+  g_free (command);
+  g_free (quoted);
+  g_free (launcher);
+  g_free (uri);
+}
+
+void
+ghid_recent_files_flush (void)
+{
+  /* The core's Quit() exits directly. Deliver GTK's pending write before exit,
+   * including a Save As immediately followed by Quit(). */
+  if (recent_manager != NULL)
+    g_signal_emit_by_name (recent_manager, "changed");
+}
+
+static void
+ghid_recent_file_activated (GtkRecentChooser *chooser, gpointer unused)
+{
+  gchar *uri = gtk_recent_chooser_get_current_uri (chooser);
+  gchar *filename = uri ? g_filename_from_uri (uri, NULL, NULL) : NULL;
+  (void) unused;
+
+  if (filename != NULL)
+    {
+      /* Use the normal open action, including its unsaved-layout confirmation.
+       * Pass a separate argument so quotes, spaces and commas remain literal. */
+      hid_actionl ("LoadFrom", "Layout", filename, NULL);
+      ghid_update_toggle_flags ();
+      ghid_mode_buttons_update ();
+      ghid_invalidate_all ();
+    }
+  g_free (filename);
+  g_free (uri);
+}
+
+static void
+ghid_recent_menu_append (GtkMenuShell *shell)
+{
+  GtkWidget *item = gtk_menu_item_new_with_mnemonic (_("Open Recen_t"));
+  GtkWidget *chooser = gtk_recent_chooser_menu_new_for_manager (ghid_recent_manager ());
+  GtkRecentFilter *filter = gtk_recent_filter_new ();
+
+  gtk_recent_filter_add_mime_type (filter, "application/x-pcb-layout");
+  gtk_recent_filter_add_pattern (filter, "*.pcb");
+  gtk_recent_chooser_add_filter (GTK_RECENT_CHOOSER (chooser), filter);
+  gtk_recent_chooser_set_show_tips (GTK_RECENT_CHOOSER (chooser), TRUE);
+  gtk_recent_chooser_set_sort_type (GTK_RECENT_CHOOSER (chooser), GTK_RECENT_SORT_MRU);
+  gtk_recent_chooser_set_limit (GTK_RECENT_CHOOSER (chooser), 10);
+  gtk_recent_chooser_set_local_only (GTK_RECENT_CHOOSER (chooser), FALSE);
+  gtk_recent_chooser_menu_set_show_numbers (GTK_RECENT_CHOOSER_MENU (chooser), TRUE);
+  g_signal_connect (chooser, "item-activated",
+                    G_CALLBACK (ghid_recent_file_activated), NULL);
+  gtk_menu_item_set_submenu (GTK_MENU_ITEM (item), chooser);
+  gtk_menu_shell_append (shell, item);
+}
 
